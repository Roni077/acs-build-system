# Ignore everything by default to prevent accidental check-in of huge tarballs/bundles
*

# Whitelist repository documentation and infrastructure
!.gitignore
!README.md
!acs-manifest.json
!manifest.json

# Whitelist scripts and automation
!scripts/
!scripts/**
scripts/__pycache__/
*.pyc

# Whitelist GitHub Actions
!.github/
!.github/**
